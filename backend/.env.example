PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Required in production: generate independently and store securely (32+ characters).
# JWT_SECRET=
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=./data/medidesk.sqlite
# Set only behind a trusted reverse proxy:
TRUST_PROXY=0

# Required independently of JWT_SECRET in production: openssl rand -hex 32
# HEALTH_DATA_KEY=
# Gmail app password: configure securely on the server, never in chat or Git.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Video remains disabled until an appropriate provider is chosen and reviewed.
VIDEO_BASE_URL=
VIDEO_PRIVACY_APPROVED=false
