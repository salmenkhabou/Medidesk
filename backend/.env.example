PORT=5000
NODE_ENV=production
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=https://medidesk.tn
DB_PATH=./data/medidesk-db.json
USERS_PATH=./data/users.json
# Set only when the backend is reachable exclusively through one trusted proxy.
TRUST_PROXY=0
# Demo endpoints are disabled in production regardless of this setting.
ENABLE_DEMO_DATA=false
