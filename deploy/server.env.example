# Save as /srv/medidesk/.env with mode 600. Never commit real values.
# Generate JWT_SECRET directly on the host with openssl rand -hex 48.
JWT_SECRET=
# Certificates live only on the host in /srv/medidesk/certs/.
# Supply fullchain.pem and privkey.pem using a verified certificate workflow.

# Preserve this key independently; losing it makes encrypted data unrecoverable.
HEALTH_DATA_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VIDEO_BASE_URL=
VIDEO_PRIVACY_APPROVED=false
