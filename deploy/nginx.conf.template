# Dedicated MediDesk proxy; no connection to the existing application's network.
server {
    listen 80;
    server_name ${SITE_HOST};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/medidesk-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 ${SITE_ORIGIN}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${SITE_HOST};
    ssl_certificate /etc/nginx/medidesk-certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/medidesk-certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    location / {
        set $medidesk_frontend frontend;
        proxy_pass http://$medidesk_frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # This public boundary replaces user-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
